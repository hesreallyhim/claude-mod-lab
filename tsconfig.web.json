{
  // The explorer page's code in web/public/, checked as JavaScript against the DOM.
  // Not strict. Run with `npm run typecheck:web`.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [],
    "skipLibCheck": true
  },
  "include": ["web/public/**/*.js"]
}
